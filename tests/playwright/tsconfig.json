{
  "compilerOptions": {
    "target": "ES2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["playwright.config.ts", "config/**/*.ts", "api/**/*.ts", "ui/**/*.ts", "hybrid/**/*.ts", "fixtures/**/*.ts", "pages/**/*.ts", "api-clients/**/*.ts", "test-data/**/*.ts"]
}
