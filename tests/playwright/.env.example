# Copy to .env (git-ignored) and adjust. Values below match the app's documented defaults.

# Frontend (Vite dev server) – used as Playwright baseURL for UI tests
BASE_URL=http://localhost:5173

# Backend API base (must include /api/v1) – used as baseURL for API tests
API_BASE_URL=http://127.0.0.1:8000/api/v1

# Default test account. Seeded accounts and their password are listed in
# docs/APPLICATION.md (section 6, "Seeded credentials and data"). Fill in the password locally.
TEST_USER_EMAIL=thandi.mokoena@example.com
TEST_USER_PASSWORD=

# Optional: secondary account for cross-parent / data-isolation tests
SECONDARY_USER_EMAIL=john.smith@example.com
SECONDARY_USER_PASSWORD=

# Parallel workers. The app uses one shared SQLite database, so 1 is the safe default.
PW_WORKERS=1

# Optional: use an installed browser instead of downloaded Chromium (msedge | chrome)
PW_BROWSER_CHANNEL=

# Optional: let Playwright start backend + frontend if they are not running (true/false)
PW_START_SERVERS=false
