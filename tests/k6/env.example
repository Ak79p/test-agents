# k6 does not read .env files. Set these as real environment variables or pass them with -e.
#
#   PowerShell:  $env:API_BASE_URL = "http://127.0.0.1:8000/api/v1"; $env:TEST_USER_PASSWORD = "<seeded password>"
#   bash/zsh:    export API_BASE_URL=http://127.0.0.1:8000/api/v1 TEST_USER_PASSWORD='<seeded password>'
#   per run:     k6 run -e API_BASE_URL=http://127.0.0.1:8000/api/v1 -e TEST_USER_PASSWORD=... scripts/<file>.js
#
API_BASE_URL=http://127.0.0.1:8000/api/v1
TEST_USER_PASSWORD=
LOAD_TEST_USERS=50
