# Copy to tests/k6/.env (git-ignored). `npm run perf:*` loads it; plain `k6 run` does not (k6 never reads .env
# files): then set real environment variables or pass -e NAME=value. Never commit real values.
# If TEST_USER_PASSWORD / API_BASE_URL are unset here, the npm runner falls back to tests/playwright/.env.

# Target: local FeeFlow API (must include /api/v1). Non-local hosts are refused unless PERF_ALLOWED_HOST matches.
API_BASE_URL=http://127.0.0.1:8000/api/v1
# PERF_ALLOWED_HOST=

# Seeded password (docs/APPLICATION.md section 6). Read only by setup(); never printed.
TEST_USER_PASSWORD=
# Read-only account for the starter read journey (not modified by it)
PERF_USER_EMAIL=loadtest001@example.com
# Number of seeded loadtestNNN accounts (backend SEED_LOAD_TEST_USERS)
LOAD_TEST_USERS=50

# Profile: smoke (default, 1 VU) | baseline | load (starters) | case (catalogue scripts/<ID>.js: the case's own
# workload from its approved plan). Anything but smoke also needs PERF_ALLOW_LOAD=yes, which you set only after
# the run is approved.
PERF_PROFILE=smoke
PERF_ALLOW_LOAD=
# PERF_ITERATIONS=1      smoke iterations (max 10)
# PERF_VUS=5             load profile VUs (max 50)
# PERF_DURATION=1m       baseline hold / load hold (load default 2m)
# PERF_RAMP_UP=30s
# PERF_RAMP_DOWN=30s
# PERF_THINK_TIME=1      seconds between iterations (non-smoke)
# PERF_REQUEST_TIMEOUT=10s
# PERF_RATE=             arrival-rate override for catalogue cases with PERF_PROFILE=case (AUTH-PERF-001 default 10/s)

# Provisional thresholds (calibrate from a measured baseline; never loosen to make a run pass)
# PERF_P95_MS=500
# PERF_P99_MS=1000
# PERF_MAX_ERROR_RATE=0.01
# PERF_MIN_CHECK_RATE=0.99

# Output directory for <script>-summary.json and <script>-report.md (relative to tests/k6)
# PERF_RESULTS_DIR=results
