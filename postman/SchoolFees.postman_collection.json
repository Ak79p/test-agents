{
  "info": {
    "name": "School Fees API (simulated)",
    "description": "Practice API for a simulated school-fee payment app. Import together with `SchoolFees.local.postman_environment.json`, run **Auth / Login** first, then **Students & Fees / Outstanding fees** to pick a fee.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Health",
      "description": "",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "Liveness/readiness. Never delayed by the simulation.",
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    },
    {
      "name": "Auth",
      "description": "",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Logs in and stores `accessToken` in the environment.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  pm.environment.set('accessToken', pm.response.json().access_token);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login - invalid password (401)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"wrong-password\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Login - invalid body (422)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"not-an-email\",\n  \"password\": \"\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Current parent",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "me"
              ]
            },
            "description": ""
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "logout"
              ]
            },
            "description": "Revokes the token. Subsequent calls with it return 401 INVALID_TOKEN."
          }
        }
      ]
    },
    {
      "name": "Students & Fees",
      "description": "",
      "item": [
        {
          "name": "List students",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/students",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "students"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200 && pm.response.json().length) {",
                  "  pm.environment.set('studentId', pm.response.json()[0].id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Get student",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/students/{{studentId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "students",
                "{{studentId}}"
              ]
            },
            "description": ""
          }
        },
        {
          "name": "List student fees",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/students/{{studentId}}/fees",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "students",
                "{{studentId}}",
                "fees"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "UNPAID",
                  "disabled": true
                }
              ]
            },
            "description": "Optional `status`: OUTSTANDING | PARTIALLY_PAID | PAID | UNPAID."
          }
        },
        {
          "name": "Outstanding fees",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/fees/outstanding",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "fees",
                "outstanding"
              ],
              "query": [
                {
                  "key": "student_id",
                  "value": "{{studentId}}",
                  "disabled": true
                },
                {
                  "key": "overdue_only",
                  "value": "true",
                  "disabled": true
                }
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Picks the first unpaid fee for the payment requests.",
                  "if (pm.response.code === 200 && pm.response.json().items.length) {",
                  "  pm.environment.set('feeId', pm.response.json().items[0].id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Fee details",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/fees/{{feeId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "fees",
                "{{feeId}}"
              ]
            },
            "description": ""
          }
        },
        {
          "name": "Dashboard",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/dashboard",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "dashboard"
              ]
            },
            "description": ""
          }
        }
      ]
    },
    {
      "name": "Payments",
      "description": "",
      "item": [
        {
          "name": "Create payment (new key)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/payments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "payments"
              ]
            },
            "description": "201 Created. Generates a new Idempotency-Key and stores `paymentId`.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fee_id\": \"{{feeId}}\",\n  \"amount_cents\": {{amountCents}},\n  \"payment_method\": \"CARD\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// A fresh Idempotency-Key per new payment attempt.",
                  "pm.environment.set('idempotencyKey', pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Stores the payment id for the following requests (no assertions).",
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "  pm.environment.set('paymentId', pm.response.json().id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Create payment (replay same key)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/payments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "payments"
              ]
            },
            "description": "Re-sends the previous key and body: 200 OK, `Idempotent-Replayed: true`, same payment.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fee_id\": \"{{feeId}}\",\n  \"amount_cents\": {{amountCents}},\n  \"payment_method\": \"CARD\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Create payment (same key, different body - 422)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/payments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "payments"
              ]
            },
            "description": "422 IDEMPOTENCY_KEY_REUSED.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fee_id\": \"{{feeId}}\",\n  \"amount_cents\": 101,\n  \"payment_method\": \"CARD\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Create payment (missing key - 400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/payments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "payments"
              ]
            },
            "description": "400 IDEMPOTENCY_KEY_MISSING.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fee_id\": \"{{feeId}}\",\n  \"amount_cents\": {{amountCents}},\n  \"payment_method\": \"CARD\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Create payment (amount exceeds balance - 422)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/payments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "payments"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fee_id\": \"{{feeId}}\",\n  \"amount_cents\": 99999999,\n  \"payment_method\": \"CARD\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Get payment",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/payments/{{paymentId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "payments",
                "{{paymentId}}"
              ]
            },
            "description": ""
          }
        },
        {
          "name": "Get payment status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/payments/{{paymentId}}/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "payments",
                "{{paymentId}}",
                "status"
              ]
            },
            "description": "Lightweight polling endpoint; `retry_after_ms` is set while PROCESSING."
          }
        },
        {
          "name": "Confirm - success (200)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/payments/{{paymentId}}/confirm",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "payments",
                "{{paymentId}}",
                "confirm"
              ]
            },
            "description": "Confirms the payment in `{{paymentId}}`. Run **Create payment (new key)** first; each confirm needs a PENDING payment. Outcome is decided by the card number.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"card\": {\n    \"number\": \"4242424242424242\",\n    \"expiry_month\": 12,\n    \"expiry_year\": 2030,\n    \"cvc\": \"123\",\n    \"holder_name\": \"Thandi Mokoena\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Confirm - declined (200, FAILED)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/payments/{{paymentId}}/confirm",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "payments",
                "{{paymentId}}",
                "confirm"
              ]
            },
            "description": "Confirms the payment in `{{paymentId}}`. Run **Create payment (new key)** first; each confirm needs a PENDING payment. Outcome is decided by the card number.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"card\": {\n    \"number\": \"4000000000000002\",\n    \"expiry_month\": 12,\n    \"expiry_year\": 2030,\n    \"cvc\": \"123\",\n    \"holder_name\": \"Thandi Mokoena\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Confirm - insufficient funds (200, FAILED)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/payments/{{paymentId}}/confirm",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "payments",
                "{{paymentId}}",
                "confirm"
              ]
            },
            "description": "Confirms the payment in `{{paymentId}}`. Run **Create payment (new key)** first; each confirm needs a PENDING payment. Outcome is decided by the card number.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"card\": {\n    \"number\": \"4000000000009995\",\n    \"expiry_month\": 12,\n    \"expiry_year\": 2030,\n    \"cvc\": \"123\",\n    \"holder_name\": \"Thandi Mokoena\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Confirm - gateway error (502)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/payments/{{paymentId}}/confirm",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "payments",
                "{{paymentId}}",
                "confirm"
              ]
            },
            "description": "Confirms the payment in `{{paymentId}}`. Run **Create payment (new key)** first; each confirm needs a PENDING payment. Outcome is decided by the card number. Payment returns to PENDING and can be confirmed again.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"card\": {\n    \"number\": \"4000000000000119\",\n    \"expiry_month\": 12,\n    \"expiry_year\": 2030,\n    \"cvc\": \"123\",\n    \"holder_name\": \"Thandi Mokoena\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Confirm - gateway timeout (504)",
          "request": {
            "method": "POST",
            "header": [
              {
