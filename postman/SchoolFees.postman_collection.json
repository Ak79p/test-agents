    {
      "name": "Development",
      "description": "Available only when APP_ENV != production and ENABLE_DEV_ENDPOINTS=true.",
      "item": [
        {
          "name": "Reset database",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/dev/reset",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "dev",
                "reset"
              ],
