# Base URL of the FastAPI backend (must include /api/v1).
# 127.0.0.1 avoids IPv6 "localhost" resolution issues on some Windows/Node setups.
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1

# Dev server host/port (keep the origin listed in backend CORS_ORIGINS)
VITE_DEV_HOST=localhost
VITE_DEV_PORT=5173

# Interval (ms) for polling a PROCESSING payment, and how long to keep polling
VITE_PAYMENT_POLL_INTERVAL_MS=1500
VITE_PAYMENT_POLL_TIMEOUT_MS=120000

# Show the simulated test-card helper on the checkout page
VITE_SHOW_TEST_CARDS=true
