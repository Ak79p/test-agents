# ---------------------------------------------------------------------------
# School Fees API - example configuration. Copy to `.env` and adjust.
# No secrets are required: all payments are simulated.
# ---------------------------------------------------------------------------

# Runtime environment: development | test | production
# Dev endpoints (database reset, runtime simulation config) are disabled in production.
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO

# SQLite database file (relative paths are resolved from the backend/ directory)
DATABASE_URL=sqlite:///./data/app.db
# Create tables and seed demo data on startup if the database is empty
SEED_ON_STARTUP=true
# Extra generated parent accounts for load testing (loadtest001@example.com ...)
SEED_LOAD_TEST_USERS=50

# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Bearer token lifetime
TOKEN_TTL_MINUTES=120

# Allow POST /api/v1/dev/reset and GET/PUT /api/v1/dev/simulation
ENABLE_DEV_ENDPOINTS=true

# Worker thread pool size for synchronous request handlers
THREADPOOL_SIZE=100

# ---------------------------------------------------------------------------
# Simulation controls (all can also be changed at runtime via PUT /api/v1/dev/simulation)
# ---------------------------------------------------------------------------
# Fixed delay added to every /api/v1 response (except /health and /dev/*)
SIM_RESPONSE_DELAY_MS=0
# Extra random delay 0..N ms on top of the fixed delay (seeded -> repeatable sequence)
SIM_RESPONSE_JITTER_MS=0
SIM_RANDOM_SEED=42
# Per-endpoint delays: JSON object of "METHOD /path-prefix" or "/path-prefix" -> ms
# e.g. {"GET /api/v1/transactions": 750, "POST /api/v1/payments": 300}
SIM_ENDPOINT_DELAYS_MS={}
# Honour the X-Simulate-Delay-Ms request header (capped by SIM_MAX_DELAY_MS)
SIM_ALLOW_DELAY_HEADER=true
SIM_MAX_DELAY_MS=30000

# Simulated gateway processing time for a normal confirmation
SIM_GATEWAY_LATENCY_MS=800
# How long the "timeout" scenario waits before responding 504
SIM_GATEWAY_TIMEOUT_MS=5000
# Seconds before a PROCESSING payment (pending/timeout scenarios) settles
SIM_PENDING_RESOLUTION_SECONDS=8
# Force an outcome for every confirmation regardless of card number:
# none | success | decline | insufficient_funds | expired_card | gateway_error | timeout | pending
SIM_PAYMENT_OUTCOME_OVERRIDE=none
# Deterministically fail every Nth confirmation with a gateway error (0 = disabled)
SIM_GATEWAY_ERROR_EVERY_N=0
